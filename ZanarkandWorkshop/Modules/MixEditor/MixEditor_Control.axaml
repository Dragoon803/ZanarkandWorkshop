<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FFXProjectEditor.MixEditor_Control">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" BorderBrush="#555555" BorderThickness="0,0,0,1" Padding="12,10">
      <Grid>
        <StackPanel>
          <TextBlock Text="Rikku Mix Recipes" FontSize="22" FontWeight="Bold"/>
        </StackPanel>
      </Grid>
    </Border>

    <DataGrid Grid.Row="1" ItemsSource="{Binding DisplayedRecipes}"
              AutoGenerateColumns="False" IsReadOnly="False"
              CanUserResizeColumns="False" CanUserSortColumns="True"
              GridLinesVisibility="All" BorderThickness="1" BorderBrush="Gray"
              HeadersVisibility="Column" SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Result" Width="190" SortMemberPath="ResultName">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{Binding ResultOptions}"
                        SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                        DisplayMemberBinding="{Binding Display}"
                        HorizontalAlignment="Stretch"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Ingredient 1" Width="210"
                                SortMemberPath="Ingredient1Name">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{Binding IngredientOptions}"
                        SelectedItem="{Binding SelectedIngredient1, Mode=TwoWay}"
                        DisplayMemberBinding="{Binding Display}"
                        HorizontalAlignment="Stretch"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Ingredient 2" Width="210"
                                SortMemberPath="Ingredient2Name">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{Binding IngredientOptions}"
                        SelectedItem="{Binding SelectedIngredient2, Mode=TwoWay}"
                        DisplayMemberBinding="{Binding Display}"
                        HorizontalAlignment="Stretch"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <ContentControl Grid.Row="2" MinHeight="50">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,4">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
          <TextBox Width="200" HorizontalAlignment="Left" VerticalAlignment="Center" Tag="EditorHistoryShortcuts"
                   Watermark="Search..." Text="{Binding FilterText}"
                   TextChanged="Filter_Changed"/>
          <TextBlock VerticalAlignment="Center" Text="{Binding HistoryStatus}"
                     Foreground="#DDDDDD" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center"
                   HorizontalAlignment="Right" Text="{Binding Status}" Foreground="#DDDDDD"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Content="Undo" Click="Undo_Click" IsEnabled="{Binding CanUndo}"/>
          <Button Content="Redo" Click="Redo_Click" IsEnabled="{Binding CanRedo}"/>
          <Button Content="Undo All" Click="UndoAll_Click" IsEnabled="{Binding CanUndoAll}"/>
          <Button Content="Save" Click="Save_Click" IsEnabled="{Binding IsDirty}"/>
        </StackPanel>
      </Grid>
    </ContentControl>
  </Grid>
</UserControl>
