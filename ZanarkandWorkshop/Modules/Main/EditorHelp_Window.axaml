<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FFXProjectEditor.EditorHelp_Window"
        Title="Zanarkand Workshop Guide"
        Width="680" Height="620"
        MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="5" Margin="0,0,0,14">
            <TextBlock Text="Zanarkand Workshop Guide" FontSize="25" FontWeight="Bold"/>
            <TextBlock Text="A quick overview of the available editors"
                       FontSize="15" Foreground="#BBBBBB"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#555555" BorderThickness="1"
                Background="#151515" CornerRadius="5">
            <ScrollViewer VerticalScrollBarVisibility="Visible"
                          HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
                <StackPanel Margin="18" Spacing="18" VerticalAlignment="Top"
                            HorizontalAlignment="Stretch">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Monster Editor" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Edits complete monster files, including combat stats, status and elemental properties, loot, rewards, and battle behavior through Battle Scripts. The Battle Script workspace provides translated logic, structured controls, worker and jump navigation, validation, and safe statement editing."
                                   TextWrapping="Wrap" Foreground="#DDDDDD"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Auto Ability Editor" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Edits Auto Ability text, properties, effects, stat increases, and recipes. Properties &amp; Effects uses a_ability.bin and Recipe uses kaizou.bin; either tab works independently. Restore Original Ability recovers only the selected entry."
                                   TextWrapping="Wrap" Foreground="#DDDDDD"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Items" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Views and edits the game’s item definitions stored in item.bin."
                                   TextWrapping="Wrap" Foreground="#DDDDDD"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Rikku Mix Recipes" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Changes the Mix produced by any two items. Search or sort the list, choose the result and ingredients from the dropdowns, then press Save. These recipes come from prepare.bin."
                                   TextWrapping="Wrap" Foreground="#DDDDDD"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Player &amp; Aeon Commands" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Views and edits commands used by party members and Aeons. These entries come from command.bin."
                                   TextWrapping="Wrap" Foreground="#DDDDDD"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Standard Monster Commands" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Views and edits attacks and commands used by standard, non-boss monsters. These entries come from monmagic1.bin."
                                   TextWrapping="Wrap" Foreground="#DDDDDD"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Boss Commands" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Views and edits commands used by bosses throughout the game. These entries come from monmagic2.bin."
                                   TextWrapping="Wrap" Foreground="#DDDDDD"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Battle Formation Editor" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Changes which monsters appear in a battle and where they stand. Select a formation, choose up to eight monsters, adjust their positions in the graph or coordinate fields, then press Save."
                                   TextWrapping="Wrap" Foreground="#DDDDDD"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Sphere Grid Editor" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Visually edits the Original, Standard, and Expert Sphere Grids. Select a node to change its type, section color, or position; select a connecting line to edit its link. You can also create nodes and links, find and replace node types, undo changes, and restore the original grids through Recovery. For game stability, grids are limited to 860 nodes, Standard/Original to 1,021 links, Expert to 934 links, and each node to five connections. Save your work and start a new game when testing a redesigned grid."
                                   TextWrapping="Wrap" Foreground="#DDDDDD"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Treasure Chest Editor" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Shows treasure chests on interactive maps reconstructed from your own game files. Select a field, click a chest icon, or use Previous Chest and Next Chest to inspect every detected chest. You can change its reward type, reward, and quantity, including Gil, items, key items, weapons, and armor. Chest positions are shown for reference and are not edited."
                                   TextWrapping="Wrap" Foreground="#DDDDDD"/>
                        <TextBlock Text="Required: jppc\battle\kernel\takara.bin and buki_get.bin; jppc\map with mapout.vpa files; and jppc\event\obj with .ebp files. Only takara.bin is changed when you save."
                                   TextWrapping="Wrap" Foreground="#BBBBBB"/>
                    </StackPanel>

                    <Border Height="1" Background="#555555"/>

                    <StackPanel Spacing="7">
                        <TextBlock Text="General text editing" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="These rules apply to every editable game-text field in Zanarkand Workshop, including monster names, Sensor and Scan text, item text, and command names and descriptions."
                                   TextWrapping="Wrap" Foreground="#DDDDDD"/>

                        <TextBlock Text="Cyan text" FontWeight="SemiBold" Foreground="#70D7E8"/>
                        <TextBlock Text="Use [cyan] before the text and [/cyan] after it. For example, [cyan]Fire[/cyan] stores Fire with the game’s cyan formatting. The markers are editor notation: the game displays the word in cyan, not the brackets."
                                   TextWrapping="Wrap" Foreground="#DDDDDD"/>

                        <TextBlock Text="Line breaks" FontWeight="SemiBold" Foreground="#70D7E8"/>
                        <TextBlock Text="Press Enter in a multiline field to insert a game line break. Line wrapping visible in the editor does not create a line break unless you press Enter."
                                   TextWrapping="Wrap" Foreground="#DDDDDD"/>

                        <TextBlock Text="Characters and validation" FontWeight="SemiBold" Foreground="#70D7E8"/>
                        <TextBlock Text="Game text uses its own limited character table rather than Unicode. If a character cannot be encoded, Save reports an error instead of writing damaged text. Replace unsupported smart quotes, symbols, or accented characters with a supported equivalent."
                                   TextWrapping="Wrap" Foreground="#DDDDDD"/>

                        <TextBlock Text="Formatting safety" FontWeight="SemiBold" Foreground="#70D7E8"/>
                        <TextBlock Text="Keep formatting markers paired and correctly ordered: [cyan]text[/cyan]. Markers are case-insensitive, but the documented lowercase form is recommended. Review multiline text in game because the game controls the final box width and pagination."
                                   TextWrapping="Wrap" Foreground="#DDDDDD"/>
                    </StackPanel>

                    <Border Height="1" Background="#555555"/>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Project and connection requirements" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Editors require a valid FFX Master folder. Utilities do not require a Master folder; they work directly with the running game and are available only while FFX is connected."
                                   TextWrapping="Wrap" Foreground="#DDDDDD"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="2" Content="Close" Click="Button_Close"
                HorizontalAlignment="Right" Margin="0,14,0,0" Padding="20,7"/>
    </Grid>
</Window>
